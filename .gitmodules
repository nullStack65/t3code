# Vendored read-only references under .repos/ (see AGENTS.md) carry two nested
# gitlinks from alchemy-effect. Without a mapping, `git submodule foreach`
# (run by actions/checkout when persist-credentials is false) fails with
# "No url found for submodule path". These entries only name the upstream
# sources; they are never initialized or updated in this repository.
[submodule ".repos/alchemy-effect/submodules/distilled"]
	path = .repos/alchemy-effect/submodules/distilled
	url = https://github.com/alchemy-run/distilled.git
	update = none
	ignore = all
[submodule ".repos/alchemy-effect/submodules/floci"]
	path = .repos/alchemy-effect/submodules/floci
	url = https://github.com/alchemy-run/floci.git
	update = none
	ignore = all
